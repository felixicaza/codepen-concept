{
  "name": "codepen-concept",
  "version": "1.0.0",
  "private": true,
  "description": "Este repositorio contiene el desarrollo del diseño experimental de Codepen, creado por BlurSoul.",
  "keywords": [
    "astro",
    "design",
    "html",
    "css",
    "ui-design",
    "codepen",
    "redesign"
  ],
  "bugs": {
    "url": "https://github.com/felixicaza/codepen-concept/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felixicaza/codepen-concept.git"
  },
  "license": "MIT",
  "author": "Felix Icaza <fx.joliett17@gmail.com>",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "astro dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "prepare": "simple-git-hooks",
    "preview": "astro preview",
    "start": "astro dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged && pnpm ls-lint",
    "commit-msg": "pnpm commitlint -c -e ${1}"
  },
  "nano-staged": {
    "*": "pnpm lint:fix"
  },
  "dependencies": {
    "@astrojs/check": "0.9.5",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.8",
    "@fontsource-variable/montserrat": "5.2.8",
    "@fontsource/monaspace-krypton": "5.2.5",
    "@lezer/highlight": "1.2.3",
    "@playform/compress": "0.2.0",
    "@playform/inline": "0.1.2",
    "@types/codemirror": "5.60.16",
    "astro": "5.16.0",
    "astro-compressor": "1.2.0",
    "astro-icon": "1.1.5",
    "astro-seo-schema": "5.1.0",
    "astro-sitemap": "1.0.0",
    "astro-tunnel": "0.1.8",
    "codemirror": "6.0.2",
    "lightningcss": "1.30.2",
    "sanitize.css": "13.0.0",
    "schema-dts": "1.1.5",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@commitlint/types": "20.0.0",
    "@eslint/js": "9.39.1",
    "@ls-lint/ls-lint": "2.3.1",
    "@typescript-eslint/parser": "8.47.0",
    "eslint": "9.39.1",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-package-json": "0.85.0",
    "eslint-plugin-yml": "1.19.0",
    "globals": "16.5.0",
    "jiti": "2.6.1",
    "nano-staged": "0.9.0",
    "neostandard": "0.12.2",
    "simple-git-hooks": "2.13.1"
  },
  "engines": {
    "node": ">=22.13.1",
    "pnpm": ">=10.0.0"
  }
}
